# ── Gemini ───────────────────────────────────────────────────
# Required unless you run with --offline (or OFFLINE_MODE=true).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.0-flash

# Tool-calling rounds allowed per agent turn before it must answer.
MAX_TOOL_ROUNDS=8
# Retries with exponential backoff on 429 / 5xx responses.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY=2.0

# Run every agent on its deterministic engine instead of Gemini.
OFFLINE_MODE=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# ── Memory ───────────────────────────────────────────────────
# Use "redis" as the host when running via docker compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Use /db/supply_chain.db in Docker so the named volume persists it.
SQLITE_PATH=supply_chain.db

AGENT_CHAT_HISTORY_MAX=20
INVENTORY_CACHE_TTL=60
NEGOTIATION_SESSION_TTL=3600

# ── Procurement policy ───────────────────────────────────────
PROCUREMENT_TARGET_FILL=0.80
SUPPLIER_MIN_RELIABILITY=0.85
SUPPLIER_PREFERRED_RELIABILITY=0.88
SUPPLIER_PREFERRED_OTD=0.90
URGENT_DAYS_OF_STOCK=21
CRITICAL_DAYS_OF_STOCK=10

# ── Negotiation policy ───────────────────────────────────────
NEGOTIATION_MAX_ROUNDS=5
NEGOTIATION_TARGET_DISCOUNT=0.08
NEGOTIATION_OPENING_DISCOUNT=0.12
NEGOTIATION_WALKAWAY_DISCOUNT=0.05

# ── Risk model ───────────────────────────────────────────────
# Risk applied to countries missing from COUNTRY_RISK_SCORES in config.py.
DEFAULT_COUNTRY_RISK=0.25
REGION_CONCENTRATION_THRESHOLD=0.50
LEAD_TIME_RISK_DAYS=20
